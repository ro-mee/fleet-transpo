{
  "expo": {
    "name": "FleetOps",
    "slug": "mobile",
    "scheme": "fleetops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fleetops-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F2EC",
        "foregroundImage": "./assets/fleetops-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/fleetops-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.fleet.mobile",
      "googleServicesFile": "./services/google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "FleetOps uses the camera to scan fuel receipts.",
          "photosPermission": "FleetOps uses your photo library to attach fuel receipts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FleetOps uses the camera to scan fuel receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FleetOps shares your location with dispatch while you are on an active trip.",
          "locationAlwaysAndWhenInUsePermission": "FleetOps shares your live location with dispatch even while you use other apps during a trip.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3c14c6f-3fcd-41f4-acf8-36d37747fc5e"
      }
    },
    "owner": "fleet23s-team"
  }
}
