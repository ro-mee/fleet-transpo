# dependencies
/node_modules/**

# Expo/React Native generated directories
/.expo/**
/android/**
/ios/**

# Build outputs
/dist/**
/build/**

# IDE and editor files
/.vscode/**
/.idea/**
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Testing
/coverage/**

# Environment files (not for build)
.env
.env.local
.env.*.local

# Git
/.git/**
.gitignore

# Misc
*.pem
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# Firebase configuration is intentionally included for Android builds.
# It remains excluded from Git in mobile/.gitignore.

# Other generated
/.expo-web*.log
