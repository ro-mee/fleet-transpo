# Server-only trip odometer photo rollout (0 = disabled, 1 = required for new starts).
# Enable only after the schema, server, compatible mobile app and web are deployed.
# Trips already latched as requiring evidence keep that requirement at completion.
ODOMETER_PHOTO_REQUIRED=0

# Optional server-only Gemini vision model override for odometer-v1 extraction.
# If unset, uses the active Gemini provider model. Does not affect fuel receipts.
GEMINI_ODOMETER_MODEL=
