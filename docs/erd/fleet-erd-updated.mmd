erDiagram
    branches {
        int branch_id PK
        varchar branch_name
        varchar branch_code UK
        text address
        varchar city
        varchar province
        varchar phone
        varchar email
        varchar status
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    roles {
        int role_id PK
        varchar role_name UK
        text description
        jsonb permissions
        timestamptz created_at
        timestamptz updated_at
    }

    employees {
        int employee_id PK
        int branch_id FK
        int role_id FK
        uuid user_id FK
        varchar first_name
        varchar last_name
        varchar position
        varchar email UK
        varchar phone
        varchar license_number
        date license_expiry
        varchar status
        text avatar_url
        int created_by FK
        int updated_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    vehiclecategories {
        int category_id PK
        varchar category_name
        text description
        decimal base_rate
        decimal per_km_rate
        decimal per_hour_rate
        int seating_capacity
        text image_url
        varchar status
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    vehicles {
        int vehicle_id PK
        int category_id FK
        int branch_id FK
        varchar plate_number UK
        varchar vehicle_name
        varchar model
        varchar manufacturer
        int year
        varchar color
        varchar fuel_type
        int seating_capacity
        decimal mileage
        decimal fuel_level
        date license_plate_expiry
        date insurance_expiry
        date registration_expiry
        date purchase_date
        decimal purchase_price
        text image_url
        varchar vehicle_status
        date last_service_date
        decimal next_service_mileage
        date next_service_date
        jsonb documents
        int created_by FK
        int updated_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    drivers {
        int driver_id PK
        int employee_id FK
        varchar license_number
        date license_expiry
        varchar license_type
        varchar license_class
        int years_of_experience
        decimal performance_score
        int total_trips
        decimal total_distance
        decimal total_hours
        decimal rating
        varchar driver_status
        decimal current_latitude
        decimal current_longitude
        timestamptz last_location_update
        text face_image_url
        int created_by FK
        int updated_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    routes {
        int route_id PK
        varchar route_name
        varchar origin
        decimal origin_latitude
        decimal origin_longitude
        varchar destination
        decimal destination_latitude
        decimal destination_longitude
        decimal estimated_distance
        int estimated_duration
        jsonb waypoints
        varchar status
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    service_types {
        int service_type_id PK
        varchar service_name
        text description
        boolean requires_vehicle
        boolean requires_driver
        int default_category_id FK
        varchar icon
        varchar color
        int sort_order
        varchar status
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    booking_channels {
        int channel_id PK
        varchar channel_name
        varchar source_system
        text description
        varchar status
        timestamptz created_at
    }

    vehiclereservations {
        int reservation_id PK
        int branch_id FK
        int vehicle_id FK
        int driver_id FK
        int service_type_id FK
        int booking_channel_id FK
        varchar external_booking_id
        varchar integration_source
        varchar guest_id
        varchar room_number
        boolean bill_to_room
        text cancellation_reason
        varchar guest_name
        varchar guest_phone
        varchar guest_email
        text pickup_location
        text dropoff_location
        decimal pickup_latitude
        decimal pickup_longitude
        decimal dropoff_latitude
        decimal dropoff_longitude
        date reservation_date
        time pickup_time
        time estimated_return_time
        varchar purpose
        text notes
        int passenger_count
        varchar status
        jsonb ai_vehicle_recommendation
        jsonb ai_driver_recommendation
        int created_by FK
        int updated_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    dispatchschedules {
        int dispatch_id PK
        int reservation_id FK
        int vehicle_id FK
        int driver_id FK
        int route_id FK
        varchar dispatch_number UK
        timestamptz scheduled_departure
        timestamptz scheduled_arrival
        timestamptz actual_departure
        timestamptz actual_arrival
        decimal estimated_distance
        int estimated_duration
        varchar status
        varchar priority
        text notes
        int created_by FK
        int updated_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

