        decimal estimated_distance
        int estimated_duration
        int actual_duration
        text origin
        text destination
        varchar trip_status
        decimal start_odometer
        decimal end_odometer
        decimal fuel_consumed
        decimal avg_speed
        decimal max_speed
        int idle_time
        jsonb route_data
        text notes
        int created_by FK
        int updated_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

