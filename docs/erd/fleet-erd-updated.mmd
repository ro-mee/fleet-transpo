        bigint tracking_id PK
        int vehicle_id FK
        int trip_id FK
        int driver_id FK
        decimal latitude
        decimal longitude
        decimal speed
        decimal heading
        decimal altitude
        decimal accuracy
        timestamptz recorded_at
    }

    vehiclemaintenance {
        int maintenance_id PK
        int vehicle_id FK
        varchar maintenance_type
        text description
        date maintenance_date
        date completed_date
        decimal cost
        decimal mileage_at_service
        varchar service_provider
        varchar service_center
        date next_schedule_date
        decimal next_schedule_mileage
        varchar status
        varchar priority
        boolean is_recurring
        int recurring_interval_days
        decimal recurring_interval_km
        text remarks
        jsonb inspection_checklist
        text inspection_findings
        varchar severity
        int created_by FK
        int updated_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    fuelrecords {
        int fuel_record_id PK
        int vehicle_id FK
        int driver_id FK
        int trip_id FK
        varchar station_name
        decimal liters
        decimal amount
        decimal price_per_liter
        decimal odometer
        varchar fuel_type
        date fuel_date
        text receipt_url
        varchar status
        int created_by FK
        int updated_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    driverattendance {
        int attendance_id PK
        int driver_id FK
        date date
        timestamptz time_in
        timestamptz time_out
        varchar check_in_method
        text face_capture_url
        decimal face_confidence
        boolean face_verified
        decimal check_in_latitude
        decimal check_in_longitude
        varchar status
        text remarks
        timestamptz created_at
        timestamptz updated_at
    }

    notifications {
        int notification_id PK
        int employee_id FK
        uuid user_id FK
        varchar title
        text message
        varchar type
        varchar channel
        varchar reference_type
        int reference_id
        boolean is_read
        timestamptz read_at
        timestamptz sent_at
        timestamptz created_at
    }

    ai_recommendations {
        int recommendation_id PK
        varchar recommendation_type
        varchar reference_type
        int reference_id
        jsonb recommendation_data
        decimal confidence_score
        text explanation
        varchar user_action
        int user_id FK
        timestamptz created_at
    }

    ai_insights {
        int insight_id PK
        varchar insight_type
        varchar title
        text description
        varchar impact
        varchar category
        jsonb related_data
        decimal confidence_score
        varchar status
        boolean is_read
        timestamptz created_at
    }

    tripcostanalysis {
        int cost_id PK
        int trip_id FK
        decimal fuel_cost
        decimal toll_fees
        decimal parking_fees
        decimal driver_cost
        decimal maintenance_cost
        decimal miscellaneous_cost
        decimal total_cost
        decimal cost_per_km
        timestamptz created_at
        timestamptz updated_at
    }

    tripperformance {
        int performance_id PK
        int trip_id FK
        int driver_id FK
        boolean on_time_completion
        int time_variance
        decimal fuel_efficiency
        decimal avg_speed
        decimal max_speed
        int idle_time
        decimal smooth_driving_score
        decimal customer_rating
        text notes
        timestamptz created_at
    }

    integration_log {
        bigint log_id PK
        varchar direction
        varchar source_system
        varchar event_type
        varchar reference_type
        int reference_id
        varchar external_booking_id
        jsonb payload
        varchar status
        text error_message
        timestamptz processed_at
        timestamptz created_at
    }

    audit_logs {
        bigint log_id PK
        int employee_id FK
        varchar action
        varchar resource
        int resource_id
        jsonb old_values
        jsonb new_values
        varchar ip_address
        text user_agent
        timestamptz created_at
    }

